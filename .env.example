# Multi-Node Storage Cluster Configuration
# Comma-separated list of storage webhook endpoints for parallel load balancing
STORAGE_WEBHOOK_URLS=https://discord.com/api/webhooks/NODE_1_ID/TOKEN,https://discord.com/api/webhooks/NODE_2_ID/TOKEN

# Legacy Single Webhook Fallback
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/NODE_1_ID/TOKEN

# Database Configuration
# If DATABASE_URL is set, AeroVault connects to PostgreSQL (e.g., Supabase / Neon / Koyeb) via asyncpg.
# If omitted or empty, AeroVault cleanly falls back to local SQLite (aerovault.db).
# DATABASE_URL=postgresql://postgres:password@db.projectref.supabase.co:5432/postgres
DATABASE_PATH=aerovault.db

# Server Settings
PORT=8000
HOST=0.0.0.0
